rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shoes/{shoeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /cart/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /shopkeepers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == uid
        && !('phone_number' in request.auth.token);
    }

    match /Orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'shoeId',
          'shoeName',
          'shoePrice',
          'shoeImage',
          'customerName',
          'customerPhone',
          'customerAddress',
          'paymentScreenshotUrl',
          'status',
          'createdAt',
          'items',
          'totalPrice'
        ])
        && request.resource.data.keys().hasOnly([
          'shoeId',
          'shoeName',
          'shoePrice',
          'shoeImage',
          'shoeCategory',
          'shoeGender',
          'selectedSize',
          'quantity',
          'lineTotal',
          'items',
          'totalPrice',
          'customerName',
          'customerPhone',
          'mobileNumber',
          'customerUid',
          'customerAddress',
          'paymentScreenshotUrl',
          'status',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerPhone.size() <= 40
        && request.resource.data.customerAddress is string
        && request.resource.data.customerAddress.size() > 0
        && request.resource.data.customerAddress.size() <= 1000
        && request.resource.data.paymentScreenshotUrl is string
        && request.resource.data.paymentScreenshotUrl.matches('https://firebasestorage\\.googleapis\\.com/.*')
        && request.resource.data.shoePrice is number
        && request.resource.data.shoePrice >= 0
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null
        && !('phone_number' in request.auth.token)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status is string
        && request.resource.data.status in ['New', 'Pending', 'Completed', 'Delivered', 'Cancelled'];
    }
  }
}
